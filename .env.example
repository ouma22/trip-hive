# MongoDB connection (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
# Optional database name (default: triphive)
MONGODB_DB_NAME=triphive

# Min. 16 characters in production
JWT_SECRET=change-me-to-a-long-random-secret-string

# Admin login password (plain text — compared on the server with a timing-safe check).
# Use single quotes if the password contains $ or other special characters:
# ADMIN_PASSWORD='your-secret-password'
ADMIN_PASSWORD=najm1234

# Restart `npm run dev` after changing this file.
